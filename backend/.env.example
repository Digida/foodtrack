# ── Security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (dev):   sqlite+aiosqlite:///./foodtrack.db
# PostgreSQL:     postgresql+asyncpg://user:pass@host:5432/foodtrack
DATABASE_URL=sqlite+aiosqlite:///./foodtrack.db

# ── App ────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to SITE_URL if not set.
# Example: https://app.foodtrack.ae,https://admin.foodtrack.ae
# CORS_ORIGINS=http://localhost:5173

# ── Email OTP (MFA) ────────────────────────────────────────────────────────
# URL of your transactional email API (e.g. SendGrid, Mailgun, Resend)
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=re_xxxxxxxxxxxxxxxx

# ── SMTP fallback (transactional email) ─────────────────────────────────────
# Used when EMAIL_API_URL is not set (e.g. Gmail/Office365 app passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_SENDER=FoodTrack <you@gmail.com>

# ── Developer / operations contact ──────────────────────────────────────────
# API keys are emailed here on creation; also used for footer credits.
# DEV_EMAIL=digikiminvest@gmail.com
# DEV_PHONE=+256700677543
# DEV_WHATSAPP=+256700677543

# ── SMS OTP (MFA) ──────────────────────────────────────────────────────────
# URL of your SMS gateway API (e.g. Twilio, Vonage, AWS SNS)
# SMS_API_URL=https://api.vonage.com/sms
# SMS_API_KEY=xxxxxxxxxxxxxxxx

# ── SSO / OAuth (authorization-code flow, PKCE S256) ───────────────────────
# All authorize/callback endpoints live under /api/v1/auth/sso/{provider}.
# SSO_REDIRECT_URI must be registered in each provider console and should
# point at the backend callback, e.g. http://localhost:8000/api/v1/auth/sso/google/callback
# SITE_URL=http://localhost:8000
# SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/google/callback
#
# Google:  https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
#
# Microsoft (Entra ID / Microsoft Account):  https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# MICROSOFT_CLIENT_ID=xxxx
# MICROSOFT_CLIENT_SECRET=xxxx
#
# Apple Sign in with Apple:  https://developer.apple.com/account/resources/identifiers
# APPLE_CLIENT_ID=com.foodtrack.app      # Service ID / app bundle ID
# APPLE_TEAM_ID=TEAMID1234
# APPLE_KEY_ID=KEYID1234
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#
# GitHub OAuth App:  https://github.com/settings/developers
# GITHUB_CLIENT_ID=xxxx
# GITHUB_CLIENT_SECRET=xxxx

# ── Demo / testing ─────────────────────────────────────────────────────────
# When true (and no email/SMS service is configured) OTP codes are returned
# in API responses so demo flows can complete. NEVER enable in production.
# RETURN_OTP_IN_DEV=false
